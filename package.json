{
  "name": "autoply",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "autoply": "node packages/cli/bin/autoply.js",
    "dev": "pnpm --filter @autoply/web dev",
    "build": "pnpm --filter @autoply/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --parallel typecheck",
    "db:generate": "pnpm --filter @autoply/core exec drizzle-kit generate --config drizzle.config.ts && node scripts/bundle-migrations.ts",
    "ci": "bash scripts/ci.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "globals": "^16.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^5.1.1"
  }
}
